#~ msgstr "Uyarıyı şu kadar tut"

#~ msgid "Group wait"
#~ msgstr "Gruplama beklemesi"

#~ msgid "Auto-detected. Change these only if needed."
#~ msgstr "Otomatik algılandı. Yalnızca gerekirse değiştirin."

