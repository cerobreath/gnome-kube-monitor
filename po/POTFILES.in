# Every shipped JavaScript file, listed whether or not it holds a translatable
# string today, so a string added to a module that had none still reaches the
# .pot. npm run i18n:check fails if this list and the source tree disagree.
#
# The GSettings schema is absent: only dconf-editor reads its summaries, and it
# never binds this extension's locale/, so the entries would be unreachable.
extension.js
prefs.js
lib/alerts.js
lib/client.js
lib/i18n.js
lib/indicator.js
lib/log.js
lib/model.js
lib/notifier.js
lib/poller.js
lib/schedule.js
lib/theme.js
