#~ msgstr "Notifier lorsque le cluster est injoignable"

#~ msgid "Notify on recovery"
#~ msgstr "Notifier le rétablissement"

#~ msgid "Keep firing for"
#~ msgstr "Maintenir l'alerte pendant"

#~ msgid "Group wait"
#~ msgstr "Délai de regroupement"

#~ msgid "Auto-detected. Change these only if needed."
#~ msgstr "Détecté automatiquement. À modifier seulement si nécessaire."

#~ msgid "kubectl detection status"
#~ msgstr "État de détection de kubectl"

#~ msgid "kubeconfig detection status"
#~ msgstr "État de détection de kubeconfig"

