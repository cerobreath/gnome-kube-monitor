msgstr ""
"Project-Id-Version: Kube Node Monitor 0.1.0\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-07-31 14:12+0300\n"
"PO-Revision-Date: 2026-07-31 01:05+0300\n"
"Last-Translator: Kube Node Monitor contributors\n"
"Language-Team: Simplified Chinese\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
