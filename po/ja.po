#: extension.js:135
msgid "Copied to clipboard"
msgstr "クリップボードにコピーしました"

#. Translators: the only page of the preferences window.
#: prefs.js:37
msgid "General"
msgstr "全般"

#. Translators: preferences group covering how often the cluster is polled.
#: prefs.js:41
msgid "Monitoring"
msgstr "監視"

#: prefs.js:45
msgid "Refresh Interval"
msgstr "更新間隔"

#: prefs.js:46
msgid "Seconds between kubectl polls"
msgstr "kubectl を実行する間隔（秒）"

#: prefs.js:53
msgid "Notifications"
msgstr "通知"

#: prefs.js:54
msgid "Choose which events notify you, and how long to wait first"
msgstr "通知するイベントと、通知するまでの待機時間を設定します"

#: prefs.js:59
msgid "Node Problems"
msgstr "ノードの問題"

#. Translators: "Ready" is a Kubernetes node state, keep it as it is.
#: prefs.js:61
msgid "Notify when a node stops being Ready"
msgstr "ノードが Ready でなくなったときに通知します"

#: prefs.js:67
msgid "Cluster Unreachable"
msgstr "クラスターへの接続不可"

#: prefs.js:68
msgid "Notify when kubectl cannot reach the cluster"
msgstr "kubectl がクラスターに接続できないときに通知します"

#: prefs.js:74
msgid "Recovery"
msgstr "復旧"

#: prefs.js:75
msgid "Also notify when a node or the cluster comes back"
msgstr "ノードやクラスターが復旧したときにも通知します"

#. Translators: how long a node must stay down before it notifies.
#: prefs.js:82
msgid "Node Delay"
msgstr "ノードの待機時間"

#. Translators: "NotReady" is a Kubernetes node state, keep it as it is.
#: prefs.js:84
msgid "Seconds a node must stay NotReady before notifying"
msgstr "ノードが NotReady になってから通知するまでの秒数"

#. Translators: how long the cluster must stay unreachable before it notifies.
#: prefs.js:92
msgid "Cluster Delay"
msgstr "クラスターの待機時間"

#: prefs.js:93
msgid "Seconds the cluster must stay unreachable before notifying"
msgstr "クラスターに接続できなくなってから通知するまでの秒数"

#. Translators: an alert stays active this long after its cause clears.
#: prefs.js:101
msgid "Hold Time"
msgstr "保持時間"

#. Translators: a node that "flaps" switches state repeatedly.
#: prefs.js:103
msgid ""
"Seconds an alert stays active after it clears, so a flapping node notifies "
"once"
msgstr ""
"原因が解消したあともアラートを保持する秒数。状態が頻繁に変わるノードでも通知"
"は 1 回だけになります"

#: prefs.js:110
msgid "Repeat Reminder"
msgstr "再通知の間隔"

#: prefs.js:111
msgid ""
"Seconds before notifying again about a still-active alert, or zero to notify "
"once"
msgstr "発生中のアラートを再通知するまでの秒数（0 なら 1 回だけ通知）"

#. Translators: alerts firing within this window become one notification.
#: prefs.js:119
msgid "Batch Window"
msgstr "まとめる時間"

#: prefs.js:120
msgid "Seconds to wait so alerts firing together arrive as one notification"
msgstr "同時に発生したアラートを 1 件の通知にまとめるために待つ秒数"

#: prefs.js:127
msgid "Connection"
msgstr "接続"

#: prefs.js:128
msgid "kubectl and the kubeconfig are found automatically"
msgstr "kubectl と kubeconfig は自動的に検出されます"

#. Translators: "context" is the kubectl term for a saved cluster
#. connection; use whatever kubectl's own translation uses.
#: prefs.js:138
msgid "Context"
msgstr "コンテキスト"

#: prefs.js:138 prefs.js:320
msgid "Which context to monitor"
msgstr "監視するコンテキスト"

#. Translators: tooltip on the status icon beside the kubectl row.
#: prefs.js:149
msgid "Whether kubectl was found"
msgstr "kubectl が見つかったかどうか"

#. Translators: tooltip on the status icon beside the kubeconfig row.
#: prefs.js:156
msgid "Whether a kubeconfig was found"
msgstr "kubeconfig が見つかったかどうか"

#. Translators: button that tries the connection. Keep it to one word if
#. you can, it is a compact button in a row.
#: prefs.js:163
msgid "Test"
msgstr "テスト"

#: prefs.js:165
msgid "Test Connection"
msgstr "接続をテスト"

#: prefs.js:165
msgid "Run kubectl and list contexts"
msgstr "kubectl を実行してコンテキストを一覧表示します"

#: prefs.js:173
msgid "Advanced"
msgstr "詳細設定"

#: prefs.js:174
msgid "Extra kubeconfig files and a custom kubectl path"
msgstr "追加の kubeconfig ファイルと、kubectl パスの指定"

#: prefs.js:181
msgid "kubectl Path"
msgstr "kubectl のパス"

#: prefs.js:191
msgid "Diagnostic Logging"
msgstr "診断ログ"

#: prefs.js:192
msgid "Record poll and alert decisions in the system log"
msgstr "ポーリングとアラートの判定をシステムログに記録します"

#: prefs.js:203
msgid "Add kubeconfig File…"
msgstr "kubeconfig ファイルを追加…"

#: prefs.js:207
msgid "Add a kubeconfig file"
msgstr "kubeconfig ファイルを追加します"

#: prefs.js:212
msgid "Select a kubeconfig File"
msgstr "kubeconfig ファイルを選択"

#. Translators: tooltip on the trash button beside a kubeconfig
#. file. %s is the file's name.
#: prefs.js:247
#, javascript-format
msgid "Remove %s"
msgstr "%s を削除"

#. Translators: shown when kubectl is not on PATH. "Advanced" is the
#. expander below, so use the same wording you gave its title.
#: prefs.js:273
msgid "Not found on PATH. Set it under Advanced."
msgstr "PATH に見つかりません。「詳細設定」でパスを指定してください。"

#. Translators: how many kubeconfig files kubectl will merge into
#. one configuration. %d is the count.
#: prefs.js:280
#, javascript-format
msgid "%d file"
msgid_plural "%d files"
msgstr[0] "%d 個のファイル"

#. Translators: %s is a file path that does not exist.
#: prefs.js:288
#, javascript-format
msgid "%s (missing)"
msgstr "%s（見つかりません）"

#. Translators: first entry of the context picker. It follows whichever
#. context kubectl has selected instead of pinning one.
#: prefs.js:308
msgid "Current context (auto)"
msgstr "現在のコンテキスト（自動）"

#. Translators: shown when no context is pinned, so the extension
#. follows kubectl's selection. %s is that context's name.
#. "current-context" is a kubeconfig field, keep it as it is.
#: prefs.js:319
#, javascript-format
msgid "Following current-context (%s)"
msgstr "current-context に追従（%s）"

#. Translators: toast after a successful connection test.
#. %d is how many contexts the kubeconfig defines.
#: prefs.js:336
#, javascript-format
msgid "Connected. Found %d context."
msgid_plural "Connected. Found %d contexts."
msgstr[0] "接続しました。%d 個のコンテキストが見つかりました。"

#. Translators: stands in for a node name in a grouped banner's list,
#. e.g. "web-1, db-2, cluster". Lowercase, to read as one list item.
#: lib/alerts.js:259
msgid "cluster"
msgstr "クラスター"

#. Translators: notification title when the cluster answers again.
#: lib/alerts.js:263
msgid "Cluster reachable again"
msgstr "クラスターに再接続しました"

#. Translators: notification title when a node stops being Ready.
#. %s is the node name as the cluster spells it; do not translate it.
#: lib/alerts.js:379
#, javascript-format
msgid "%s is down"
msgstr "%s がダウンしました"

#. Translators: notification title when a node becomes Ready again.
#. %s is the node's name.
#: lib/alerts.js:383
#, javascript-format
msgid "%s recovered"
msgstr "%s が復旧しました"

#. Translators: banner title when several alerts fire at the same time.
#. %d is how many; the body lists the node names.
#: lib/alerts.js:429
#, javascript-format
msgid "%d alert firing"
msgid_plural "%d alerts firing"
msgstr[0] "%d 件のアラートが発生中"

#. Translators: banner title when several alerts clear at the same time.
#. %d is how many; the body lists the node names.
#: lib/alerts.js:432
#, javascript-format
msgid "%d alert recovered"
msgid_plural "%d alerts recovered"
msgstr[0] "%d 件のアラートが復旧"

#. Translators: spoken cluster state. Every node is Ready.
#: lib/indicator.js:55
msgid "healthy"
msgstr "正常"

#. Translators: spoken cluster state. Something is wrong, nothing is down.
#: lib/indicator.js:57
msgid "degraded"
msgstr "問題あり"

#. Translators: spoken cluster state. At least one node is down.
#: lib/indicator.js:59
msgid "critical"
msgstr "危険"

#. Translators: spoken cluster state. No reading yet, or kubectl failed.
#: lib/indicator.js:61
msgid "status unknown"
msgstr "状態不明"

#. Translators: a choice in the "Mute alerts" submenu. %d is a number
#. of minutes.
#: lib/indicator.js:81
#, javascript-format
msgid "For %d minute"
msgid_plural "For %d minutes"
msgstr[0] "%d 分間"

#. Translators: a choice in the "Mute alerts" submenu. %d is a number of hours.
#: lib/indicator.js:85
#, javascript-format
msgid "For %d hour"
msgid_plural "For %d hours"
msgstr[0] "%d 時間"

#. Translators: placeholder in the menu header before the first poll lands.
#: lib/indicator.js:207 lib/indicator.js:456
msgid "Loading…"
msgstr "読み込み中…"

#. Translators: spoken name of the icon-only refresh button.
#: lib/indicator.js:232
msgid "Refresh now"
msgstr "今すぐ更新"

#. Translators: shown under the context name after a manual refresh,
#. until the poll answers.
#. Translators: shown under the context name while the first poll of a
#. cluster is still in flight.
#: lib/indicator.js:238 lib/indicator.js:764
msgid "updating…"
msgstr "更新中…"

#. Translators: submenu that mutes alert banners for a while.
#: lib/indicator.js:295 lib/indicator.js:347
msgid "Mute alerts"
msgstr "アラートをミュート"

#. Translators: menu row that cancels an active mute.
#: lib/indicator.js:303
msgid "Turn muting off"
msgstr "ミュートを解除"

#. Translators: menu row that opens the extension's preferences window.
#: lib/indicator.js:312
msgid "Settings"
msgstr "設定"

#. Translators: the "Mute alerts" row while muting is active. %s is a
#. short duration such as "45m" or "2h".
#: lib/indicator.js:344
#, javascript-format
msgid "Muted · %s left"
msgstr "ミュート中 · 残り %s"

#. Translators: spoken state of the cluster switcher when its list is open.
#: lib/indicator.js:372
msgid "expanded"
msgstr "展開"

#. Translators: spoken state of the cluster switcher when its list is closed.
#: lib/indicator.js:374
msgid "collapsed"
msgstr "折りたたみ"

#. Translators: spoken name of the menu header button. %1$s is the current
#. context name, %2$s is "expanded" or "collapsed".
#: lib/indicator.js:377
#, javascript-format
msgid "%1$s, %2$s, cluster switcher"
msgstr "%1$s、%2$s、クラスター切り替え"

#. Translators: shown in the cluster switcher when the kubeconfig
#. defines no contexts.
#: lib/indicator.js:391
msgid "No contexts"
msgstr "コンテキストがありません"

#. Translators: last row of the cluster switcher; opens preferences so
#. another kubeconfig can be added.
#: lib/indicator.js:407
msgid "Add connection…"
msgstr "接続を追加…"

#. Translators: spoken name of the selected row in the cluster switcher.
#. %s is the context name, a cluster identifier, so leave it as it is.
#: lib/indicator.js:434
#, javascript-format
msgid "%s, current"
msgstr "%s、使用中"

#. Translators: spoken summary of the whole cluster. %1$s is a state word
#. ("healthy", "degraded", …), %2$d is how many nodes are Ready and %3$d
#. how many there are. The plural form follows the total, %3$d.
#: lib/indicator.js:495
#, javascript-format
msgid "%1$s, %2$d of %3$d node ready"
msgid_plural "%1$s, %2$d of %3$d nodes ready"
msgstr[0] "%1$s、%3$d ノード中 %2$d ノードが Ready"

#. Translators: shown in place of the node list when the cluster
#. reports no nodes at all.
#: lib/indicator.js:566
msgid "No nodes"
msgstr "ノードがありません"

#. Translators: closes a truncated node list. %d is how many
#. further nodes exist that the menu did not draw.
#: lib/indicator.js:579
#, javascript-format
msgid "… and %d more node"
msgid_plural "… and %d more nodes"
msgstr[0] "… 他 %d ノード"

#. Translators: spoken uptime on a node row: how long it has been
#. Ready. %s is a short duration such as "3d".
#: lib/indicator.js:670
#, javascript-format
msgid "up %s"
msgstr "稼働 %s"

#. Translators: spoken downtime on a node row: how long it has been
#. NotReady. %s is a short duration such as "3d".
#: lib/indicator.js:673
#, javascript-format
msgid "down %s"
msgstr "停止 %s"

#. Translators: spoken CPU load on a node row. %d is a percentage.
#: lib/indicator.js:676
#, javascript-format
msgid "CPU %d%%"
msgstr "CPU %d%%"

#. Translators: spoken memory load on a node row. %d is a percentage.
#: lib/indicator.js:680
#, javascript-format
msgid "memory %d%%"
msgstr "メモリ %d%%"

#. Translators: pod counts under the menu header. English has one form for
#. all counts, but %d selects the plural form your language needs. Keep
#. these very short: up to four of them share one row.
#: lib/indicator.js:726
#, javascript-format
msgid "%d running"
msgid_plural "%d running"
msgstr[0] "%d 実行中"

#. Translators: pods accepted but not yet started. Keep it very short.
#: lib/indicator.js:730
#, javascript-format
msgid "%d pending"
msgid_plural "%d pending"
msgstr[0] "%d 待機中"

#. Translators: pods stuck restarting (CrashLoopBackOff). Keep it very short.
#: lib/indicator.js:735
#, javascript-format
msgid "%d crashing"
msgid_plural "%d crashing"
msgstr[0] "%d クラッシュ"

#. Translators: pods that terminated in failure. Keep it very short.
#: lib/indicator.js:740
#, javascript-format
msgid "%d failed"
msgid_plural "%d failed"
msgstr[0] "%d 失敗"

#. Translators: spoken name of the panel button. "Kube Node Monitor" is
#. the extension's name, so leave it as it is. %s is the cluster summary.
#: lib/indicator.js:750
#, javascript-format
msgid "Kube Node Monitor: %s"
msgstr "Kube Node Monitor: %s"

#. Translators: shown under the context name when the reading is only a
#. few seconds old, in place of a duration.
#: lib/indicator.js:772
msgid "now"
msgstr "たった今"

#. Translators: abbreviated duration in seconds, e.g. "45s". %d is the
#. number of seconds. Keep it short: it shares a menu row with the node name.
#: lib/model.js:150
#, javascript-format
msgctxt "duration"
msgid "%ds"
msgstr "%d秒"

#. Translators: abbreviated duration in minutes, e.g. "45m". %d is the
#. number of minutes.
#: lib/model.js:155
#, javascript-format
msgctxt "duration"
msgid "%dm"
msgstr "%d分"

#. Translators: abbreviated duration in hours, e.g. "5h". %d is the
#. number of hours.
#: lib/model.js:160
#, javascript-format
msgctxt "duration"
msgid "%dh"
msgstr "%d時間"

#. Translators: abbreviated duration in days, e.g. "3d". %d is the number
#. of days.
#: lib/model.js:164
#, javascript-format
msgctxt "duration"
msgid "%dd"
msgstr "%d日"

#. Translators: shown when the cluster did not respond before the timeout.
#: lib/model.js:594
msgid "The cluster didn't answer in time"
msgstr "クラスターが時間内に応答しませんでした"

#. Translators: TLS/x509 certificate verification failed.
#: lib/model.js:596
msgid "The cluster's certificate can't be verified"
msgstr "クラスターの証明書を検証できませんでした"

#. Translators: the API server rejected the credentials (HTTP 401).
#: lib/model.js:598
msgid "The cluster rejected the login"
msgstr "クラスターがログイン情報を拒否しました"

#. Translators: an expired token that a credential helper must refresh.
#: lib/model.js:600
msgid "The login has expired"
msgstr "ログインの有効期限が切れました"

#. Translators: authenticated, but not permitted to list nodes (HTTP 403).
#: lib/model.js:602
msgid "This login can't read the cluster"
msgstr "このログインではクラスターを読み取れません"

#. Translators: the kubectl binary itself could not be found or executed.
#: lib/model.js:604
msgid "Can't find kubectl"
msgstr "kubectl が見つかりません"

#. Translators: the network could not reach the API server at all.
#: lib/model.js:606
msgid "Can't reach the cluster"
msgstr "クラスターに接続できません"

#. Translators: the machine itself is offline, so the failure is local.
#: lib/model.js:608
msgid "No internet connection"
msgstr "インターネット接続がありません"

#. Translators: no kubeconfig file exists to read a cluster from.
#: lib/model.js:610
msgid "No kubeconfig found"
msgstr "kubeconfig が見つかりません"

#. Translators: the selected context is missing from the kubeconfig.
#: lib/model.js:612
msgid "The selected context doesn't exist"
msgstr "選択されたコンテキストは存在しません"

#. Translators: catch-all when kubectl failed for none of the above reasons.
#: lib/model.js:614
msgid "kubectl ran into a problem"
msgstr "kubectl で問題が発生しました"

#~ msgid "Log diagnostics"
#~ msgstr "診断情報を記録"

#~ msgctxt "meter"
#~ msgid "CPU"
#~ msgstr "CPU"

#~ msgctxt "meter"
#~ msgid "MEM"
#~ msgstr "メモリ"

#~ msgid "Notify on node up/down"
#~ msgstr "ノードの停止と復旧を通知"

#~ msgid "Alert when a node goes down or recovers"
#~ msgstr "ノードが停止または復旧したときに通知します"

#~ msgid ""
#~ "How and when alerts fire. Debounce and hold windows ride out brief blips."
#~ msgstr ""
#~ "アラートを出す条件です。デバウンスと保持の時間で、短時間の不調を吸収しま"
#~ "す。"

#~ msgid "Notify when the cluster is unreachable"
#~ msgstr "クラスターに接続できないときに通知"

#~ msgid "Notify on recovery"
#~ msgstr "復旧時にも通知"

#~ msgid "Keep firing for"
#~ msgstr "アラートの保持時間"

#~ msgid "Group wait"
#~ msgstr "グループ化の待ち時間"

#~ msgid "Auto-detected. Change these only if needed."
#~ msgstr "自動検出されます。必要な場合のみ変更してください。"

#~ msgid "kubectl detection status"
#~ msgstr "kubectl の検出状況"

#~ msgid "kubeconfig detection status"
#~ msgstr "kubeconfig の検出状況"

#, javascript-format
#~ msgid "For troubleshooting: %s"
#~ msgstr "トラブルシューティング用: %s"
