{
  "name": "kube-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "description": "Dev tooling for the Kube Node Monitor GNOME Shell extension (tests, lint, JSDoc type-check). Not shipped with the extension.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --import ./tests/hooks.mjs tests/*.test.js",
    "coverage": "node --test --import ./tests/hooks.mjs --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.js",
    "lint": "eslint --cache --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "check": "npm run lint && npm run typecheck && npm run coverage && npm run i18n:check",
    "pack": "glib-compile-schemas schemas/ && gnome-extensions pack --force --podir=po --extra-source=lib --extra-source=icons --extra-source=LICENSE .",
    "i18n:pot": "./po/i18n.sh pot",
    "i18n:update": "./po/i18n.sh update",
    "i18n:compile": "./po/i18n.sh compile",
    "i18n:check": "./po/i18n.sh check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": "eslint --cache --cache-location .eslintcache --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@girs/gnome-shell": "^50.0.4",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "typescript": "^7.0.2"
  }
}
