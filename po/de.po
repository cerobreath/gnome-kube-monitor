#~ msgstr "Benachrichtigen, wenn der Cluster nicht erreichbar ist"

#~ msgid "Notify on recovery"
#~ msgstr "Bei Wiederherstellung benachrichtigen"

#~ msgid "Keep firing for"
#~ msgstr "Warnung halten für"

#~ msgid "Group wait"
#~ msgstr "Gruppierungswartezeit"

#~ msgid "Auto-detected. Change these only if needed."
#~ msgstr "Automatisch erkannt. Nur bei Bedarf ändern."

#~ msgid "kubectl detection status"
#~ msgstr "Erkennungsstatus von kubectl"

#~ msgid "kubeconfig detection status"
#~ msgstr "Erkennungsstatus von kubeconfig"

#, javascript-format
#~ msgid "For troubleshooting: %s"
#~ msgstr "Zur Fehlersuche: %s"
