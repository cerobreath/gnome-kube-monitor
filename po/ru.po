#~ msgstr "Уведомлять о падении и восстановлении узлов"

#~ msgid "Alert when a node goes down or recovers"
#~ msgstr "Показывать уведомление, когда узел падает или восстанавливается"

#~ msgid ""
#~ "How and when alerts fire. Debounce and hold windows ride out brief blips."
#~ msgstr ""
#~ "Как и когда срабатывают уведомления. Окна задержки и удержания сглаживают "
#~ "кратковременные сбои."

#~ msgid "Notify when the cluster is unreachable"
#~ msgstr "Уведомлять, когда кластер недоступен"

#~ msgid "Notify on recovery"
#~ msgstr "Уведомлять о восстановлении"

#~ msgid "Keep firing for"
#~ msgstr "Удерживать срабатывание"

#~ msgid "Group wait"
#~ msgstr "Ожидание группировки"

#~ msgid "Auto-detected. Change these only if needed."
#~ msgstr "Определено автоматически. Меняйте только при необходимости."

#~ msgid "kubectl detection status"
#~ msgstr "Состояние обнаружения kubectl"

#~ msgid "kubeconfig detection status"
#~ msgstr "Состояние обнаружения kubeconfig"

#, javascript-format
#~ msgid "For troubleshooting: %s"
#~ msgstr "Для диагностики: %s"
